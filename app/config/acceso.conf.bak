# ---------------------------------------------------------------------------
# Sistema de control de acceso - configuracion
#
# Los valores de [camara] y [codec] son fragmentos de tuberia de GStreamer:
# se pueden probar tal cual con gst-launch-1.0 antes de ponerlos aqui.
# ---------------------------------------------------------------------------

[camara]
# Perfil de poca luz manteniendo 30 fps fijos:
# - exposicion manual de 33.3 ms (333): el maximo que cabe en un cuadro a
#   30 fps, y exactamente 4 ciclos del parpadeo de 120 Hz de las lamparas de
#   60 Hz, asi que no hay parpadeo ni bandas. Si baja de ~29.5 fps, usar 330.
# - ganancia moderada (5) para menos grano; la claridad la recupera gamma.
# - brillo y compensacion de contraluz en 0: los negros no se lavan.
# - nitidez a la mitad: no acentua el grano; saturacion baja: disimula el
#   tinte verde de los fluorescentes. power_line_frequency=2 -> 60 Hz.
# auto_exposure=1 (manual) tiene que ir ANTES que exposure_time_absolute.
fuente      = v4l2src device=/dev/video0 extra-controls="c,auto_exposure=1,exposure_time_absolute=333,gain=5,brightness=0,backlight_compensation=0,contrast=300,saturation=200,sharpness=64,power_line_frequency=2"
caps        = image/jpeg,width=1280,height=720,framerate=30/1
# gamma aclara las sombras sin subir los negros (1.3 a 2.0; mas alto = mas claro)
convertidor = jpegdec ! videoconvert ! gamma gamma=1.5

# --- Valores anteriores, por si hay que volver atras ---
# fuente      = v4l2src device=/dev/video0 extra-controls="c,auto_exposure=1,exposure_time_absolute=250"
# convertidor = jpegdec ! videoconvert


# --- Camara USB (UVC) en la Raspberry Pi 4 ---
# fuente      = v4l2src device=/dev/video0
# caps        = image/jpeg,width=1280,height=720,framerate=30/1
# convertidor = jpegdec ! videoconvert

# E3: reconexion ante falla de la camara
reintento_s    = 5.0
reintentos_max = 0

[codec]
# 4 Mbit/s: una escena con poca luz tiene ruido, que consume bits; con
# 2.5 Mbit/s aparecian bloques. Costo: ~1.8 GB por hora de grabacion.
# Perfil High: comprime mejor que Baseline con el mismo bitrate. Si la app
# no arranca con un error "not-negotiated", quitar ",profile=(string)high".
encoder     = v4l2h264enc extra-controls="controls,video_bitrate=4000000,h264_i_frame_period=30,repeat_sequence_header=1"
caps_salida = video/x-h264,level=(string)4,profile=(string)high

# --- Valores anteriores, por si hay que volver atras ---
# encoder     = v4l2h264enc extra-controls="controls,video_bitrate=2500000,h264_i_frame_period=30,repeat_sequence_header=1"
# caps_salida = video/x-h264,level=(string)4
fps         = 30
gop         = 30

# --- Codificador por hardware del BCM2711 (solo en la RPi 4) ---
# encoder     = v4l2h264enc extra-controls="controls,video_bitrate=2500000,h264_i_frame_period=30,repeat_sequence_header=1"
# caps_salida = video/x-h264,level=(string)4

[grabacion]
habilitada            = true
directorio            = evidencia
patron                = evidencia_%05d.mp4
segundos_por_segmento = 60
max_megabytes         = 2048

[streaming]
habilitado = true
host       = 172.21.255.137
puerto     = 5000

#127.0.0.1

[clips]
habilitados      = true
directorio       = eventos
segundos_antes   = 5
segundos_despues = 5
max_buffers      = 600

[actuador]
# RF-5 / CU-4: buzzer pasivo en GPIO 18 (pin fisico 12) por PWM de hardware.
# Requiere en /boot/firmware/config.txt (y reiniciar):
#   dtoverlay=pwm,pin=18,func=2
#   dtparam=audio=off
# backend: pwm      -> si no hay PWM, la app se detiene con error (usar en la placa)
#          auto     -> si no hay PWM, usa el simulado y avisa en el log
#          simulado -> solo registra en el log (desarrollo en la PC)
backend                 = pwm
pwm_chip                = 0
pwm_canal               = 0

frecuencia_permitido_hz = 2500
duracion_permitido_ms   = 800

frecuencia_denegado_hz  = 800
pitidos_denegado        = 3
duracion_pitido_ms      = 200
pausa_pitido_ms         = 150

[eventos]
fuente              = fifo
fifo                = /tmp/acceso-eventos
timeout_decision_s  = 30.0
enfriamiento_s      = 2.0

# CU-3: canal TCP para el puesto de vigilancia (ver acceso/red.py)
# red_clientes: IPs autorizadas separadas por coma. Vacio = cualquiera.
# Para la demo conviene poner solo la IP de la computadora del vigilante.
red_habilitada      = true
red_puerto          = 5001
red_clientes        =

[bitacora]
ruta = accesos.log

[registro]
nivel = INFO
