MACHINE ??= "qemux86-64"
USER_CLASSES ?= "buildstats"
PATCHRESOLVE = "noop"
BB_DISKMON_DIRS ??= "\
    STOPTASKS,${TMPDIR},1G,100K \
    STOPTASKS,${DL_DIR},1G,100K \
    STOPTASKS,${SSTATE_DIR},1G,100K \
    STOPTASKS,/tmp,100M,100K \
    HALT,${TMPDIR},100M,1K \
    HALT,${DL_DIR},100M,1K \
    HALT,${SSTATE_DIR},100M,1K \
    HALT,/tmp,10M,1K"
CONF_VERSION = "2"
DISTRO = "poky"
MACHINE = "raspberrypi4-64"
INIT_MANAGER = "systemd"
IMAGE_FSTYPES = "wic.bz2 wic.bmap"
LICENSE_FLAGS_ACCEPTED += "synaptics-killswitch"
DISTRO_FEATURES:append = " gobject-introspection-data"
MACHINE_FEATURES:append = " qemu-usermode"
PACKAGECONFIG:pn-opencv = "python3 png jpeg"
RPI_EXTRA_CONFIG = "dtoverlay=pwm,pin=18,func=2\ndtparam=audio=off"
ENABLE_UART = "1"
GPU_MEM = "128"
DL_DIR ?= "${TOPDIR}/../downloads"
SSTATE_DIR ?= "${TOPDIR}/../sstate-cache"
BB_HASHSERVE_DB_DIR = "${SSTATE_DIR}"
BB_NUMBER_THREADS = "2"
PARALLEL_MAKE = "-j 2"

# El buzzer pasivo necesita PWM por hardware. meta-raspberrypi declara
# RPI_KERNEL_DEVICETREE_OVERLAYS como una lista EXPLICITA de overlays a
# desplegar, y pwm.dtbo no esta en ella: el archivo existe en los
# rpi-bootfiles del firmware, pero nunca llega a /boot/overlays/.
# Sin esto el firmware ignora el dtoverlay=pwm de config.txt en silencio
# y /sys/class/pwm/ queda vacio.
RPI_KERNEL_DEVICETREE_OVERLAYS:append = " overlays/pwm.dtbo overlays/pwm-2chan.dtbo"

# C2: encoder H.264 por software, para comparar contra el de hardware.
# x264 esta bajo GPL y la receta lo marca con LICENSE_FLAGS "commercial":
# sin aceptarlo, el PACKAGECONFIG se ignora en silencio y el plugin no existe.
LICENSE_FLAGS_ACCEPTED += "commercial"
PACKAGECONFIG:append:pn-gstreamer1.0-plugins-ugly = " x264"

# SBOM y analisis de vulnerabilidades. La primera corrida descarga el indice
# de CVE del NIST (varios cientos de MB) y puede tardar bastante.
# Analisis de vulnerabilidades. OJO: en wrynose la clase se llama
# sbom-cve-check; en Scarthgap y anteriores era cve-check, y usar ese nombre
# falla con "Could not inherit file classes/cve-check.bbclass".
# La primera corrida descarga el indice del NIST y tarda bastante.
INHERIT += "sbom-cve-check"
