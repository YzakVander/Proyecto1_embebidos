# --- Yocto: nunca se versiona el directorio de compilacion ---
build/
layers/
downloads/
sstate-cache/

# --- Salidas de ejecucion de la aplicacion ---
app/evidencia/
app/eventos/
app/grafos/*
app/accesos.log
*.mp4
*.h264
*.jpg
*.png
*.dot

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/

# --- Editor / sistema ---
.vscode/
.idea/
*.swp

# Copias comprimidas: el codigo ya esta versionado
*.zip
*.7z

*.zip
*.7z

app/credenciales/
*.png

# Las capturas de las mediciones son evidencia del acta (D2): se versionan
!app/mediciones/**/*.png

# Credenciales traidas por los clientes de vigilancia: un QR de mantenimiento
# abre la puerta, no puede llegar al repositorio
*.bmp
recibidos/
credenciales-recibidas/
.cache-miniaturas/

# Respaldos de los scripts de parcheo
*.bak

# Grafos medidos en la placa: evidencia de A1-A6 (criterio de aceptacion)
!app/grafos/*-rpi4.dot
!app/grafos/*-rpi4.svg

# Grafo del receptor del puesto de vigilancia (grafo-receptor.sh)
!app/grafos/receptor.dot
!app/grafos/receptor.svg
